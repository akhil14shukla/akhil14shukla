{
  "name": "method-glance",
  "displayName": "Method Glance",
  "description": "Fold everything except method signatures and their docstrings to quickly glance over what a file's methods do.",
  "version": "0.1.0",
  "publisher": "akhil14shukla",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "fold",
    "folding",
    "docstring",
    "outline",
    "python"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "methodGlance.fold",
        "title": "Method Glance: Fold to Method Signatures & Docstrings",
        "category": "Method Glance"
      },
      {
        "command": "methodGlance.unfold",
        "title": "Method Glance: Unfold Everything",
        "category": "Method Glance"
      },
      {
        "command": "methodGlance.showMap",
        "title": "Method Glance: Show Glance Map",
        "category": "Method Glance",
        "icon": "$(type-hierarchy)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "methodGlance.showMap",
          "group": "navigation",
          "when": "editorLangId =~ /^(python|javascript|javascriptreact|typescript|typescriptreact|java|c|cpp|csharp|go|rust|php|kotlin|scala|swift|dart|groovy)$/"
        }
      ]
    },
    "keybindings": [
      {
        "command": "methodGlance.fold",
        "key": "ctrl+k ctrl+g",
        "mac": "cmd+k cmd+g",
        "when": "editorTextFocus"
      },
      {
        "command": "methodGlance.unfold",
        "key": "ctrl+k ctrl+u",
        "mac": "cmd+k cmd+u",
        "when": "editorTextFocus"
      },
      {
        "command": "methodGlance.showMap",
        "key": "ctrl+k ctrl+m",
        "mac": "cmd+k cmd+m",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Method Glance",
      "properties": {
        "methodGlance.foldOnOpen": {
          "type": "boolean",
          "default": false,
          "description": "Automatically fold to method signatures and docstrings when a supported file becomes active."
        },
        "methodGlance.showCallCarets": {
          "type": "boolean",
          "default": true,
          "description": "Mark methods that call a sibling with a gutter caret. Requires a language server that supports call hierarchy."
        },
        "methodGlance.showShapeAnnotations": {
          "type": "boolean",
          "default": true,
          "description": "Show an inline logic skeleton (branches, loops, error handling, side effects) after each method's docstring."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "tsc -p ./ && node ./out/test/run.js && node ./out/test/semantic.js && node ./out/test/layout.js && node ./out/test/shape.js && node ./out/test/sequence.js && node ./out/test/classes.js && node ./out/test/dataflow.js && node ./out/test/webview.js && node ./out/test/modules.js",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.4.0"
  }
}
